{
  "name": "senior",
  "version": "0.1.0",
  "private": true,
  "description": "Senior monorepo: Next.js frontend + monolithic NestJS backend, managed by Turborepo.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "pnpm --filter frontend run dev",
    "dev:backend": "pnpm --filter backend run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test:ci",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
