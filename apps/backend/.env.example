NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://senior:senior@localhost:5432/senior

# Required, 32+ chars. Left empty on purpose: `pnpm env:init` generates one when it
# creates .env. Otherwise use: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Placeholders let the app, `db:seed` and `dev:token` run locally without Google.
# Replace with real values from Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID (Web) to use Google sign-in.
GOOGLE_CLIENT_ID=local-dev-placeholder
GOOGLE_CLIENT_SECRET=local-dev-placeholder
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Web app origin, allowed by CORS (API calls and generation event streams).
FRONTEND_URL=http://localhost:3000

# Response cache and the design-generation queue (BullMQ); required in
# production. Unset = in-process cache, queue on redis://localhost:6379.
REDIS_URL=redis://localhost:6379
# Lifetime of cached GET responses; 0 disables response caching.
CACHE_TTL_SECONDS=60

# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# json | pretty (default: json in production, pretty otherwise)
# LOG_FORMAT=pretty
# Database queries slower than this (ms) are logged as warnings.
SLOW_QUERY_MS=500

# LLM design generation (OpenAI-compatible API with JSON-schema output).
LLM_BASE_URL=https://gateway.ai.cpe.kmutt.ac.th/v1
# Never commit a real key; put it in .env only.
LLM_API_KEY=
LLM_MODEL=qwen3.8-27b
# LLM_TIMEOUT_MS=300000
# LLM_MAX_TOKENS=16000
# Skip the model's reasoning phase (vLLM enable_thinking=false); much faster.
# LLM_DISABLE_THINKING=true
# Times the model may fix a design failing the UI kit / WCAG 2.0 checks.
# DESIGN_REPAIR_ATTEMPTS=2
# Redis namespace of the job queues: give each environment sharing a Redis its own.
# QUEUE_PREFIX=senior
# Run the BullMQ generation worker in this process; jobs it runs at once.
# GENERATION_WORKER=true
# GENERATION_CONCURRENCY=2

# Development only: user created by `db:seed` and used by `dev:token`
DEV_ADMIN_EMAIL=admin@senior.local
