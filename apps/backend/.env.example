NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://senior:senior@localhost:5432/senior

# Required, 32+ chars. Left empty on purpose: `pnpm env:init` generates one when it
# creates .env. Otherwise use: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Placeholders let the app, `db:seed` and `dev:token` run locally without Google.
# Replace with real values from Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID (Web) to use Google sign-in.
GOOGLE_CLIENT_ID=local-dev-placeholder
GOOGLE_CLIENT_SECRET=local-dev-placeholder
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Development only: user created by `db:seed` and used by `dev:token`
DEV_ADMIN_EMAIL=admin@senior.local
