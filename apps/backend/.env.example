NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://senior:senior@localhost:5432/senior

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Development only: user created by `db:seed` and used by `dev:token`
DEV_ADMIN_EMAIL=admin@senior.local
