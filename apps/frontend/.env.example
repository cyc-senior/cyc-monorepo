# Backend API base URL
# Local dev: http://localhost:4000/api
# Production: https://api.cyc.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Optional, server-only: where this site proxies /api/* (next.config.ts).
# Needed only when NEXT_PUBLIC_API_URL is relative (e.g. /api, same origin).
# BACKEND_URL=http://localhost:4000
